# ==============================================================================
# Task-Bound Runtime Security Gateway for AI Agents - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control. It is listed in .gitignore.
# ==============================================================================

# Agent Execution Mode:
# 'gemini' — use real Google Gemini API (requires GEMINI_API_KEY)
# 'mock'   — standalone deterministic simulation (no API key needed, great for demos)
AGENT_MODE=gemini

# ------------------------------------------------------------------------------
# Gemini API Configuration (Google AI Studio / Gemini REST API)
# ------------------------------------------------------------------------------
# Base URL for Google's Generative Language API.
# The backend constructs the full endpoint as:
#   POST {GEMINI_API_URL}/v1beta/models/{GEMINI_MODEL}:generateContent
GEMINI_API_URL=https://generativelanguage.googleapis.com

# Your Gemini API key from https://aistudio.google.com/app/apikey
# NEVER hardcode this in Python source files.
# NEVER expose this to the frontend.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier. Examples:
#   gemini-2.0-flash        (fast, recommended for agentic tasks)
#   gemini-1.5-flash        (previous generation)
#   gemini-1.5-pro          (more capable, slower)
GEMINI_MODEL=gemini-2.0-flash

# HTTP timeout in seconds for Gemini API calls:
GEMINI_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# Orchestration & Server Settings
# ------------------------------------------------------------------------------
# Maximum number of agent reasoning steps per task (prevents runaway loops):
MAX_ORCHESTRATION_STEPS=10

# SQLite database path:
DATABASE_URL=sqlite:///./storage/app.db

# CORS origins for the frontend (comma-separated, or * for development):
CORS_ORIGINS=*
